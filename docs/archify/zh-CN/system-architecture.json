  "cards": [
    {
      "dot": "cyan",
      "title": "前端与入口",
      "items": [
        "同一 Go 二进制内嵌 Vue 3 管理端与公开页面，经反向代理以 /admin/ 路径分发",
        "短码 GET /:code 由全局中间件 shortCodeDispatch 拦截分发，不占用 Gin 根路由"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据与部署模式",
      "items": [
        "单机模式：SQLite + 内存缓存 + 本地发号，零外部依赖（DATABASE_DRIVER=sqlite）",
        "生产模式：MySQL/PostgreSQL + Redis 缓存与分布式发号（CACHE_DRIVER=redis）",
        "goose 管理 migrations/{mysql,postgresql,sqlite} 三方言迁移，安装完成后自动执行"
      ]
    },
    {
      "dot": "rose",
      "title": "认证与安全",
      "items": [
        "AuthMiddleware 按 HMAC 签名 > JWT Bearer > API Token 优先级认证",
        "Workspace 中间件按 X-Workspace-Id 解析工作区角色（RBAC）",
        "登录限流位于认证服务内部；未接入消息队列，跳转链路全同步"
      ]
    }
  ]
