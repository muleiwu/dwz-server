  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend & ingress",
      "items": [
        "One Go binary embeds the Vue 3 admin UI and public pages, served under /admin/ behind the reverse proxy",
        "Short-code GET /:code is intercepted by the global shortCodeDispatch middleware, keeping the Gin root route free"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data & deployment modes",
      "items": [
        "Standalone: SQLite + in-memory cache + local ID generation, zero external deps (DATABASE_DRIVER=sqlite)",
        "Production: MySQL/PostgreSQL + Redis (CACHE_DRIVER=redis); goose runs migrations per dialect"
      ]
    },
    {
      "dot": "rose",
      "title": "Auth & security",
      "items": [
        "AuthMiddleware authenticates by priority: HMAC signature > JWT Bearer > API Token",
        "Workspace middleware resolves roles per X-Workspace-Id (RBAC); login rate limiting lives in the auth service"
      ]
    }
  ]
