{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "dwz-server Short-Code Redirect Sequence",
    "locale": "en",
    "output": "redirect-flow.en.html",
    "viewBox": [
      1080,
      640
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "dispatch-entry",
        "label": "Entry dispatch",
        "focus": [
          "visitor",
          "dispatch",
          "controller"
        ],
        "note": "The short-code request is intercepted by global middleware and handed to the redirect controller."
      },
      {
        "id": "cache-fallback",
        "label": "Cache & fallback",
        "focus": [
          "service",
          "cache",
          "db"
        ],
        "note": "On cache miss the short_links table is queried and the entry is written back for 24 hours."
      },
      {
        "id": "gate-and-branch",
        "label": "Gate & split",
        "focus": [
          "service",
          "security",
          "routing",
          "visitor"
        ],
        "note": "The security gate and advanced routing / A/B split decide the target URL; stats are recorded async."
      }
    ]
  },
